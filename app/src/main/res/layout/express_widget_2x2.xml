<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:theme="@style/PipiWidgetTheme">

    <ImageView
        android:id="@+id/widget_compact_brand_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_express_gradient_surface"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_express_empty_gradient_mask"
        android:tint="#FF3482FF"
        tools:ignore="UseAppTint" />

    <!-- One shared line-art layer keeps both states at the same position and opacity. -->
    <ImageView
        android:id="@+id/widget_compact_line_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_express_empty_2x2_bg" />

    <LinearLayout
        android:id="@+id/widget_compact_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_compact_shipment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_compact_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_compact_courier_logo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="9dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/widget_compact_identity"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_priority_status"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="24"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical|start"
                        android:includeFontPadding="false"
                        android:lineHeight="24dp"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/widget_compact_company"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="14"
                        android:ellipsize="end"
                        android:gravity="center_vertical|start"
                        android:includeFontPadding="false"
                        android:lineHeight="14dp"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_compact_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="3"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_compact_all"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_compact_pill_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp">

            <ImageView
                android:id="@+id/widget_compact_all_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_express_empty_box"
                android:tint="#FFFFFFFF"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/widget_compact_all_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_compact_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/widget_compact_empty_header"
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <FrameLayout
            android:id="@+id/widget_compact_empty_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/widget_compact_empty_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_compact_empty_vehicle"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_express_empty_vehicle" />

                <TextView
                    android:id="@+id/widget_compact_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_empty_message"
                    android:textColor="@color/widget_empty_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Use the same padded frame as 4x2 so One UI resolves the search edge identically. -->
    <FrameLayout
        android:id="@+id/widget_compact_empty_search_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/express_widget_search_edge_inset">

        <ImageView
            android:id="@+id/widget_compact_empty_search"
            style="@style/DeliveriesExpressWidgetSearch"
            android:layout_gravity="top|end"
            tools:ignore="UseAppTint" />
    </FrameLayout>
</FrameLayout>
