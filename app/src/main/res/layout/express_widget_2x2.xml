<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:theme="@style/PipiWidgetTheme">

    <ImageView
        android:id="@+id/widget_compact_brand_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_express_gradient_surface"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_express_brand_gradient_mask" />

    <RelativeLayout
        android:id="@+id/widget_compact_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="0dp">

        <RelativeLayout
            android:id="@+id/widget_compact_status_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/widget_compact_logos"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/widget_compact_search"
            android:layout_marginEnd="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="start"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_compact_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_priority_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_status_waiting"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="23dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/widget_wait_count"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_active_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12dp"
                    tools:ignore="SpUsage" />
            </LinearLayout>
        </RelativeLayout>

        <ImageView
        android:id="@+id/widget_compact_search"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/search_express_hint"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_search"
        android:tint="?attr/colorOnSurfaceVariant"
        tools:ignore="UseAppTint" />

        <FrameLayout
            android:id="@+id/widget_compact_logos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_compact_overlap_1"
                android:layout_width="7dp"
                android:layout_height="22dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@drawable/express_2x2_overlap_1_bg" />

            <TextView
                android:id="@+id/widget_compact_overlap_2"
                android:layout_width="4dp"
                android:layout_height="16dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/express_2x2_overlap_2_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_compact_logo1"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/widget_compact_logo2"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/widget_compact_logo3"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/widget_compact_logo4"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </FrameLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/widget_compact_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_express_gradient_surface"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_compact_empty_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_express_gradient_surface"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_express_brand_gradient_mask" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.22"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_express_empty_2x2_bg" />

        <ImageView
            android:id="@+id/widget_compact_empty_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/search_express_hint"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            android:tint="?attr/colorPrimary"
            tools:ignore="UseAppTint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="-6dp"
            android:layout_marginEnd="-6dp"
            android:layout_marginBottom="-10dp"
            android:background="@drawable/widget_express_empty_2x2_text_bg" />

        <TextView
            android:id="@+id/widget_compact_empty_text"
            android:layout_width="116dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="22dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1.2dp"
            android:maxLines="2"
            android:text="@string/widget_empty_compact"
            android:textColor="@color/widget_empty_text"
            android:textSize="14dp"
            tools:ignore="SpUsage" />

        <ImageView
            android:id="@+id/widget_compact_empty_box"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_above="@id/widget_compact_empty_text"
            android:layout_centerHorizontal="true"
            android:contentDescription="@null"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_express_empty_box"
            android:tint="?attr/colorPrimary"
            tools:ignore="UseAppTint" />
    </RelativeLayout>
</FrameLayout>
